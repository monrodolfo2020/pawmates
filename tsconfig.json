{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 no longer picks up every installed @types package on
    // its own; the unit tests (src/**/__tests__) need Jest's globals.
    "types": ["jest"]
  },
  // The end-to-end tests run in Node, not in the app: they have their own
  // config (e2e/tsconfig.json).
  "exclude": ["node_modules", "e2e", "babel.config.js", "metro.config.js", "android", "ios"]
}
